<?xml version="1.0" encoding="utf-8"?>
<!-- =============================================================================
     PoliMusic · web.config
     -----------------------------------------------------------------------------
     IIS NO incluye "index.asp" en su lista de documentos predeterminados
     (Default.htm, Default.asp, index.htm, index.html, iisstart.htm). Sin esta
     declaración, http://localhost:84/ devuelve 403.14 - Forbidden.
     ========================================================================== -->
<configuration>
    <system.webServer>

        <!-- 1. Documento predeterminado de la aplicación -->
        <defaultDocument enabled="true">
            <files>
                <add value="index.asp" />
                <add value="login.asp" />
            </files>
        </defaultDocument>

        <!-- 2. Listado de directorios desactivado (seguridad) -->
        <directoryBrowse enabled="false" />

        <!-- 3. Tipos MIME que necesita el reproductor -->
        <staticContent>
            <remove fileExtension=".mp3" />
            <mimeMap fileExtension=".mp3" mimeType="audio/mpeg" />
            <remove fileExtension=".m4a" />
            <mimeMap fileExtension=".m4a" mimeType="audio/mp4" />
        </staticContent>

    </system.webServer>
</configuration>
